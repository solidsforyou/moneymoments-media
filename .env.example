# Copy to .env and fill in. Never commit .env.
# From Meta App Dashboard -> Instagram -> API setup with Instagram login -> Business login settings
IG_APP_ID=
IG_APP_SECRET=
# Must exactly match a redirect URI registered in Business login settings
IG_REDIRECT_URI=https://localhost/

# Optional: Graph API version (check https://developers.facebook.com/docs/graph-api/changelog)
IG_API_VERSION=v24.0
# Optional: where the long-lived token is cached (gitignored)
IG_TOKEN_FILE=.sfy_token.json
