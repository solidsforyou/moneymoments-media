    "arena": "node scripts/build-arena.mjs && python3 ../content/arena/tools/check.py ../content/arena"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
