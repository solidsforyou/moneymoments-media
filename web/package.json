{
  "name": "opensource-everything-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenSource Everything on the web: OSE, Tomorrow, OpenPrep and GoodHabit, ready for Netlify.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build-arena.mjs && vite build",
